# Secrets — never commit
.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# Framework source now ships as plain files (nested .git removed). Keep the
# credential-bearing properties file out; .env is excluded by the rule above.
data/01_selenium_framework/repo/src/main/resources/data.properties

# Qdrant local storage + model cache
qdrant_storage/
.models/

# Local tools (standalone Qdrant binary)
.tools/

# Generated reports / logs
output/*
!output/.gitkeep
*.log
# ...but keep the sample Jenkins logs that ship with the demo data
!data/10_jenkins_logs/*.log
