# Secrets — never commit
.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# Sample source data ships with the demo. Cloned framework repos stay out —
# they are embedded git repos with large traces/videos and a bundled .env.
data/**/repo/

# Qdrant local storage + model cache
qdrant_storage/
.models/

# Local tools (standalone Qdrant binary)
.tools/

# Generated reports / logs
output/*
!output/.gitkeep
*.log
# ...but keep the sample Jenkins logs that ship with the demo data
!data/10_jenkins_logs/*.log
