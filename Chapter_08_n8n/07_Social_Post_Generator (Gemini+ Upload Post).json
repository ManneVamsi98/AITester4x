    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a LinkedIn post.\n\nTopic: {{ $json.output.properties.topic.type}}\nAngle: {{ $json.output.properties.angle.type }}\nAudience: {{ $json.output.properties.audience.type }}\n\nRules: no contractions, no emojis, plain declarative sentences, short paragraphs, one clear takeaway, 150-250 words. Also produce a post title and a one-sentence image prompt describing a clean technical illustration for this post. ",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You write LinkedIn posts for a software testing audience. Return only the fields required by the schema."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
