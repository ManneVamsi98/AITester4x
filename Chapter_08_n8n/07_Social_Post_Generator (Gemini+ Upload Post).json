        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"post_title\": { \"type\": \"string\" },\n    \"post_body\": { \"type\": \"string\" },\n    \"hash_tags\": { \"type\": \"string\" },\n    \"image_prompt\": { \"type\": \"string\" }\n  },\n  \"required\": [\"post_title\", \"post_body\",\"hash_tags\", \"image_prompt\"]\n}"
