              "value": "YOUR_GEMINI_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gemini-3.1-flash-lite-image\",\n  \"input\": [\n    {\n      \"type\": \"text\",\n      \"text\": \"{{ $json.output.image_prompt }}\"\n    }\n  ]\n} ",
        "options": {}
      },
