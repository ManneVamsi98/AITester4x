  "name": "08_RegressionTestDraft",
  "nodes": [
    {
      "parameters": {
        "content": "## Regression Test Draft\n\nJira prod-bug event -> AI Agent drafts a regression test -> append a row to Google Sheets.\n\nDraft only. Requires QA review before the case is approved.",
        "height": 224,
        "width": 304,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        0,
        -240
      ],
      "typeVersion": 1,
      "id": "a4f81cd0-c748-4010-9bf6-23f84941a21a",
      "name": "Sticky Note - Regression Test Draft"
    },
    {
      "parameters": {
        "jiraVersion": "cloud",
        "events": [
          "jira:issue_created",
          "jira:issue_updated"
        ],
        "additionalFields": {
          "filter": "labels = production-bug ORDER BY created DESC"
        }
      },
      "type": "n8n-nodes-base.jiraTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "id": "ee198b9a-c82e-4392-82f1-6c84afdaec03",
      "name": "Jira Trigger - Production Bug",
      "webhookId": "484441a3-0264-45dd-95c7-cd8e66e95bbd",
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "REPLACE_WITH_JIRA_CREDENTIAL_ID",
          "name": "Jira SW Cloud account"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Draft a regression test case from the following production incident.\n\nJira Key: {{ $json.issue?.key }}\nEvent: {{ $json.webhookEvent }}\nSummary: {{ $json.issue?.fields?.summary }}\nDescription: {{ $json.issue?.fields?.description }}\nPriority: {{ $json.issue?.fields?.priority?.name }}\nLabels: {{ $json.issue?.fields?.labels }}\nReporter: {{ $json.issue?.fields?.reporter?.displayName }}\nResolution: {{ $json.issue?.fields?.resolution?.name }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a senior QA engineer and Regression Test Specialist with deep experience turning production incidents into precise, reusable regression tests. You have written thousands of regression cases for web, API, and mobile products.\n\nYour job:\nGiven one production incident, draft exactly ONE new regression test case that would have caught this defect before it reached production.\n\nRules:\n1. Work ONLY from the incident details provided. Do not invent product behaviour, modules, or fields.\n2. If a required detail is missing or unclear, write \"TBD\" for that field instead of guessing.\n3. Copy the incoming Jira key verbatim into jira_key.\n4. test_case_title must be specific and start with the action under test, not the bug number.\n5. test_steps must be an ordered, numbered list of independently executable steps (use 1. 2. 3.).\n6. expected_result must assert the correct post-fix behaviour, i.e. the defect no longer reproduces.\n7. preconditions lists the required state, data, account role, and environment.\n8. test_data lists the concrete inputs needed, or \"TBD\" when unknown.\n9. bug_summary is a one or two sentence restatement of the production defect.\n10. root_cause_hypothesis is a short, clearly-marked hypothesis (prefix with \"Hypothesis:\") and never presented as confirmed fact.\n11. automation_notes state whether the case is a good automation candidate and which layer (UI, API, unit) best covers it.\n12. review_status must always be exactly \"Draft - Requires QA Review\". Never approve your own output.\n\nControlled vocabularies (use these exact values):\n- severity: S0 - Blocker, S1 - Critical, S2 - Major, S3 - Minor, S4 - Trivial\n- priority: P0 - Immediate, P1 - Urgent, P2 - High, P3 - Normal, P4 - Low\n- test_type: Functional, Regression, Integration, API, UI, Performance, Security\n\nOutput contract:\nReturn ONLY a single JSON object that conforms to the structured output schema. No markdown, no code fences, no commentary, and no extra fields."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        384,
        0
      ],
      "id": "44d2b9c5-b121-4d42-a037-b280c1e5c3de",
