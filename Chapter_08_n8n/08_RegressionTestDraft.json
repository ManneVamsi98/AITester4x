      },
      "type": "n8n-nodes-base.jiraTrigger",
      "typeVersion": 1.1,
      "position": [
        -160,
        832
      ],
      "id": "0bfe7aef-8f83-4aa9-a5f9-03e144721a3b",
      "name": "Jira Trigger - Production Bug1",
      "webhookId": "484441a3-0264-45dd-95c7-cd8e66e95bbd",
      "credentials": {
        "jiraSoftwareCloudApi": {
