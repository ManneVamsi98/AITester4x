  "name": "08_RegressionTestDraft",
  "nodes": [
    {
      "parameters": {
        "content": "## Regression Test Draft\n\nJira prod-bug event -> AI Agent drafts a regression test -> append a row to Google Sheets.\n\nDraft only. Requires QA review before the case is approved.",
        "height": 224,
        "width": 304,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -160,
        592
      ],
      "typeVersion": 1,
      "id": "e0548d63-17ea-41c8-81ea-4e4c94077f29",
      "name": "Sticky Note - Regression Test Draft1"
    },
    {
      "parameters": {
        "events": [
          "jira:issue_created",
          "jira:issue_updated"
        ],
        "additionalFields": {
          "filter": "labels = production-bug ORDER BY created DESC"
