    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Normalize a Jira issue into a flat, prompt-friendly object.\n//\n// Jira Cloud returns `fields.description` in Atlassian Document Format (ADF) -\n// a nested JSON tree, not plain text. We flatten it so the AI Agent receives\n// readable prose instead of raw ADF. This mirrors the ADF handling in\n// Chapter 3 (Jira_TestCase_Generator/jira_client.py).\n\nfunction adfToText(node) {\n  if (node === null || node === undefined) return '';\n  if (typeof node === 'string') return node;\n  if (Array.isArray(node)) return node.map(adfToText).join('');\n\n  if (typeof node === 'object') {\n    switch (node.type) {\n      case 'text':\n        return node.text || '';\n      case 'hardBreak':\n        return '\\n';\n      case 'codeBlock':\n        return '\\n' + adfToText(node.content).trim() + '\\n';\n      case 'paragraph':\n      case 'heading':\n      case 'listItem':\n        return adfToText(node.content).trim() + '\\n';\n      default:\n        return adfToText(node.content);\n    }\n  }\n\n  return String(node);\n}\n\n// Pull the \"Acceptance Criteria\" section out of the description text.\nfunction extractAcceptanceCriteria(text) {\n  const match = text.match(\n    /acceptance\\s+criteri[ae]\\s*[:\\-]?\\s*([\\s\\S]*?)(?=\\n\\s*(?:[A-Z][A-Za-z /]{2,40})\\s*[:\\-]|$)/i\n  );\n  return match ? match[1].trim() : '';\n}\n\nconst issue = $input.first().json;\nconst fields = issue.fields || {};\n\nconst descriptionText = adfToText(fields.description).trim();\nconst baseUrl = (issue.self || '').split('/rest/')[0];\n\nconst joinNames = (list) =>\n  Array.isArray(list) && list.length\n    ? list.map((item) => item.name).filter(Boolean).join(', ')\n    : 'None';\n\nreturn [\n  {\n    json: {\n      jira_key: issue.key || '',\n      story_summary: fields.summary || 'Not specified',\n      description_text: descriptionText || 'Not specified',\n      acceptance_criteria: extractAcceptanceCriteria(descriptionText) || 'Not specified',\n      issue_type: (fields.issuetype && fields.issuetype.name) || 'Not specified',\n      status: (fields.status && fields.status.name) || 'Not specified',\n      priority: (fields.priority && fields.priority.name) || 'Not specified',\n      labels: Array.isArray(fields.labels) && fields.labels.length ? fields.labels.join(', ') : 'None',\n      components: joinNames(fields.components),\n      reporter: (fields.reporter && fields.reporter.displayName) || 'Not specified',\n      created: fields.created || '',\n      jira_url: baseUrl && issue.key ? baseUrl + '/browse/' + issue.key : '',\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
